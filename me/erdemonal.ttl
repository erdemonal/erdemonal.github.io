erdemonal:saint-etienne
  a schema:City, schema:Place ;
  schema:name
    "Saint-Étienne"@fr,
    "Saint-Etienne"@en,
    "St. Etienne"@en ;
  schema:alternateName
    "Armeville"@fr,
    "Commune d'Armes"@fr ;
  schema:description """Saint-Étienne, also written St. Etienne, is a city and the prefecture of the Loire département in east-central France, located in the Massif Central, approximately 60 km southwest of Lyon, in the Auvergne-Rhône-Alpes region. Saint-Étienne is the thirteenth most populous commune in France and the second most populous commune in the Auvergne-Rhône-Alpes region.

During the French Revolution, in November 1793, the city temporarily shed its religious name, Saint-Étienne. Because the city's metalworkers and factories worked around the clock to mass-produce rifles and weapons for the French revolutionary military, the town was officially renamed Armeville (also referred to as Commune d'Armes). The name Armeville was officially abolished, and the city reverted to the name Saint-Étienne by a royal decree issued by King Louis XVIII on July 8, 1814."""@en ;
  schema:addressCountry "FR" ;
  schema:addressRegion "Auvergne-Rhône-Alpes" ;
